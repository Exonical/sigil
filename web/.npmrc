# Project-scoped setting, approved by the user (2026-10-10). Do not copy it into user or global npm config.
# Tailwind 4's @tailwindcss/oxide declares an optional native package, @tailwindcss/oxide-wasm32-wasi. npm 12's
# default allow-remote=none refuses to fetch that tarball (EALLOWREMOTE), so `npm ci` fails. `root` was tested and
# still refuses it. `all` is the narrowest value that allows it. Every resolved URL in package-lock.json is
# https://registry.npmjs.org/ with an integrity hash, and integrity checks stay on.
allow-remote=all
